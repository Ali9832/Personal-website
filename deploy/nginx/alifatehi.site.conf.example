# Copy this file to /etc/nginx/sites-available/alifatehi.site and adjust the
# document root and PHP-FPM socket for the target server.
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    root /var/www/alifatehi.site/out;
    index index.html;

    # Keep the canonical Persian URLs unprefixed.
    location = /fa { return 308 /; }
    location ~ ^/fa/(.*)$ {
        # Do not redirect an internal error_page subrequest.
        if ($request_uri ~ ^/fa/) { return 308 /$1; }
        try_files $uri =404;
    }

    # The export uses directory/index.html for every page.
    # Add the canonical trailing slash before resolving the file.
    location ~ ^/(?!en(?:/|$)|fa(?:/|$)|api(?:/|$)|_next(?:/|$)|og(?:/|$)|media(?:/|$)|fonts(?:/|$))[^.]*[^/]$ {
        return 308 $uri/;
    }

    location = / {
        try_files /fa/index.html =404;
    }

    # PHP is used only by the contact form. Change the socket to the installed
    # PHP version (for example php8.3-fpm.sock) on the server.
    location = /api/contact.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location = /api/config.php { deny all; }
    location ~ ^/api/ { try_files $uri =404; }

    # Clean Persian URLs map to the physical /fa tree; English keeps /en.
    location / {
        try_files $uri $uri/ /fa$uri/index.html =404;
    }

    error_page 404 /fa/404/index.html;

    location ~* \.(?:css|js|woff2?|ttf|avif|webp|png|jpe?g|gif|svg|ico|mp4)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
        try_files $uri =404;
    }

    location ~* \.html$ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    location ~ /(?:\.env|\.git|package(?:-lock)?\.json|tsconfig\.json|.*\.mjs)(?:$|/) {
        deny all;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
